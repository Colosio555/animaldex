extends layout

block content
  style.
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes floatA {
      0%, 100% { transform: translateY(0px) rotate(-2deg); }
      50%       { transform: translateY(-14px) rotate(2deg); }
    }
    @keyframes floatB {
      0%, 100% { transform: translateY(0px) rotate(3deg); }
      50%       { transform: translateY(-18px) rotate(-3deg); }
    }
    @keyframes floatC {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-10px); }
    }
    @keyframes shimmer {
      0%   { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    .a1 { opacity:0; animation: fadeInUp 0.7s ease 0.1s forwards; }
    .a2 { opacity:0; animation: fadeInUp 0.7s ease 0.25s forwards; }
    .a3 { opacity:0; animation: fadeInUp 0.7s ease 0.4s forwards; }
    .a4 { opacity:0; animation: fadeInUp 0.7s ease 0.55s forwards; }
    .a5 { opacity:0; animation: fadeInUp 0.7s ease 0.7s forwards; }
    .float-a { animation: floatA 6s ease-in-out infinite; }
    .float-b { animation: floatB 8s ease-in-out infinite; }
    .float-c { animation: floatC 5s ease-in-out infinite; }
    .stat-card {
      position: relative;
      overflow: hidden;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
      text-decoration: none;
      display: block;
    }
    .stat-card:hover { transform: translateY(-8px); }
    .stat-card .card-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .stat-card:hover .card-img { transform: scale(1.08); }
    .stat-card .card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.85) 100%);
      transition: opacity 0.3s ease;
    }
    .shimmer-text {
      background: linear-gradient(90deg, #4ade80, #22d3ee, #a78bfa, #4ade80);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: shimmer 4s linear infinite;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #22c55e;
      color: white;
      font-weight: 900;
      padding: 16px 32px;
      border-radius: 16px;
      font-size: 1rem;
      transition: all 0.2s ease;
      box-shadow: 0 8px 30px rgba(34,197,94,0.4);
      text-decoration: none;
    }
    .btn-primary:hover { background: #4ade80; transform: scale(1.05); box-shadow: 0 12px 40px rgba(34,197,94,0.5); }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.07);
      color: white;
      font-weight: 700;
      padding: 16px 32px;
      border-radius: 16px;
      font-size: 1rem;
      border: 1px solid rgba(255,255,255,0.15);
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-secondary:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.3); }

  div(style="min-height:100vh; background: radial-gradient(ellipse at 55% 35%, #0d2e1a 0%, #071018 55%, #030a10 100%); position:relative; overflow:hidden;")

    //- Fondo decorativo
    div(style="position:absolute; inset:0; pointer-events:none; overflow:hidden;")
      div(style="position:absolute; top:15%; left:-8%; width:550px; height:550px; border-radius:50%; background:radial-gradient(circle, rgba(34,197,94,0.07) 0%, transparent 70%);")
      div(style="position:absolute; bottom:5%; right:-5%; width:450px; height:450px; border-radius:50%; background:radial-gradient(circle, rgba(56,189,248,0.05) 0%, transparent 70%);")
      div(style="position:absolute; inset:0; opacity:0.03; background-image:radial-gradient(circle, #4ade80 1px, transparent 1px); background-size:48px 48px;")
      div(class="float-a" style="position:absolute; top:12%; left:6%; font-size:3rem; opacity:0.1;") 🌿
      div(class="float-b" style="position:absolute; top:20%; right:8%; font-size:2.5rem; opacity:0.08;") 🦋
      div(class="float-c" style="position:absolute; bottom:28%; left:10%; font-size:2rem; opacity:0.07;") 🌱
      div(class="float-a" style="position:absolute; bottom:18%; right:6%; font-size:2.8rem; opacity:0.08;") 🐾

    //- Navbar solo logo
    nav(class="a1 relative z-10 flex items-center px-8 py-6")
      div(class="flex items-center gap-3")
        span(class="text-2xl") 🌿
        span(class="text-xl font-black text-white tracking-tight") AnimaliaDex

    //- Hero
    div(class="relative z-10 max-w-4xl mx-auto px-6 pt-10 pb-8 text-center")
      div(class="a1 inline-flex items-center gap-2 bg-green-500/10 border border-green-400/20 text-green-400 text-xs uppercase tracking-widest px-4 py-2 rounded-full mb-8")
        span(style="width:6px; height:6px; border-radius:50%; background:#4ade80; display:inline-block;")
        span Explorador educativo del reino animal

      h1(class="a2 text-5xl md:text-7xl font-black text-white leading-tight mb-4")
        | El reino animal
        br
        span(class="shimmer-text") en tus manos

      p(class="a3 text-white/45 text-lg max-w-xl mx-auto mb-10 leading-relaxed") Una plataforma colaborativa para estudiantes de biología. Explora, aprende y contribuye con nuevas especies.

      div(class="a4 flex flex-col sm:flex-row items-center justify-center gap-4 mb-4")
        a(href="/registro" class="btn-primary")
          span Crear cuenta gratis
          span →
        a(href="/login" class="btn-secondary") Iniciar sesión

      div(class="a4 mt-2")
        a(href="/invitado" class="text-white/30 hover:text-white/60 text-sm transition-colors") Continuar sin cuenta →

    //- Tarjetas con imagen real
    div(class="a5 relative z-10 max-w-4xl mx-auto px-6 pb-16 mt-10")
      div(class="grid grid-cols-1 md:grid-cols-3 gap-5")

        //- Card 1 — Catálogo
        a(href="/login" class="stat-card border border-white/8 rounded-3xl" style="background:#0d1f12;")
          div(style="position:relative; overflow:hidden; border-radius:24px 24px 0 0; height:160px;")
            img(src="https://images.unsplash.com/photo-1474511320723-9a56873867b5?w=600&q=80" alt="León" class="card-img")
            div(class="card-overlay")
            div(style="position:absolute; top:14px; left:14px;")
              span(style="background:rgba(34,197,94,0.2); border:1px solid rgba(34,197,94,0.3); color:#4ade80; font-size:10px; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; padding:4px 10px; border-radius:20px;") Catálogo
            div(style="position:absolute; bottom:14px; left:14px;")
              span(style="color:white; font-weight:900; font-size:2rem; line-height:1;") 9 grupos
          div(style="padding:20px;")
            h3(style="color:white; font-weight:900; font-size:1rem; margin-bottom:8px;") Vertebrados e invertebrados
            p(style="color:rgba(255,255,255,0.35); font-size:0.8rem; line-height:1.6; margin-bottom:16px;") Fichas completas con taxonomía, hábitat y estado de conservación UICN.
            div(style="display:flex; align-items:center; gap:6px; color:#4ade80; font-size:0.75rem; font-weight:800;")
              span Explorar catálogo
              span →

        //- Card 2 — Ciencia
        a(href="/login" class="stat-card border border-white/8 rounded-3xl" style="background:#0a1a20;")
          div(style="position:relative; overflow:hidden; border-radius:24px 24px 0 0; height:160px;")
            img(src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=600&q=80" alt="Pez" class="card-img")
            div(class="card-overlay")
            div(style="position:absolute; top:14px; left:14px;")
              span(style="background:rgba(34,211,238,0.15); border:1px solid rgba(34,211,238,0.3); color:#22d3ee; font-size:10px; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; padding:4px 10px; border-radius:20px;") Ciencia
            div(style="position:absolute; bottom:14px; left:14px;")
              span(style="color:white; font-weight:900; font-size:2rem; line-height:1;") +30 especies
          div(style="padding:20px;")
            h3(style="color:white; font-weight:900; font-size:1rem; margin-bottom:8px;") Datos científicos reales
            p(style="color:rgba(255,255,255,0.35); font-size:0.8rem; line-height:1.6; margin-bottom:16px;") Nombre científico, peso, comportamiento, curiosidades y clasificación taxonómica.
            div(style="display:flex; align-items:center; gap:6px; color:#22d3ee; font-size:0.75rem; font-weight:800;")
              span Ver especies
              span →

        //- Card 3 — Comunidad
        a(href="/registro" class="stat-card border border-white/8 rounded-3xl" style="background:#160d20;")
          div(style="position:relative; overflow:hidden; border-radius:24px 24px 0 0; height:160px;")
            img(src="https://images.unsplash.com/photo-1444464666168-49d633b86797?w=600&q=80" alt="Ave" class="card-img")
            div(class="card-overlay")
            div(style="position:absolute; top:14px; left:14px;")
              span(style="background:rgba(168,85,247,0.15); border:1px solid rgba(168,85,247,0.3); color:#a78bfa; font-size:10px; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; padding:4px 10px; border-radius:20px;") Comunidad
            div(style="position:absolute; bottom:14px; left:14px;")
              span(style="color:white; font-weight:900; font-size:2rem; line-height:1;") Tú aquí
          div(style="padding:20px;")
            h3(style="color:white; font-weight:900; font-size:1rem; margin-bottom:8px;") Contribuye al catálogo
            p(style="color:rgba(255,255,255,0.35); font-size:0.8rem; line-height:1.6; margin-bottom:16px;") Propón nuevas especies, publica hallazgos y reacciona al contenido de la comunidad.
            div(style="display:flex; align-items:center; gap:6px; color:#a78bfa; font-size:0.75rem; font-weight:800;")
              span Unirse ahora
              span →

    footer(class="relative z-10 text-center py-6 text-white/15 text-xs border-t border-white/5") AnimaliaDex · Explorador de especies · 2026
