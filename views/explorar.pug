extends layout

block content
  style.
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .nav-bar {
      opacity: 0;
      animation: slideDown 0.4s ease forwards;
    }
    .animal-card {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      display: block;
      text-decoration: none;
      opacity: 0;
      animation: fadeUp 0.45s ease forwards;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      transition: transform 0.25s, border-color 0.2s;
    }
    .animal-card:hover {
      transform: translateY(-4px);
      border-color: rgba(74,222,128,0.3);
    }
    .animal-card img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .animal-card:hover img {
      transform: scale(1.07);
    }
    .card-body {
      padding: 12px 14px 14px;
    }
    .card-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(74,222,128,0.7);
      background: rgba(74,222,128,0.08);
      border: 1px solid rgba(74,222,128,0.15);
      padding: 3px 9px;
      border-radius: 20px;
      margin-bottom: 7px;
    }
    .card-name {
      color: white;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 2px;
    }
    .card-sci {
      color: rgba(255,255,255,0.3);
      font-size: 11px;
      font-style: italic;
      margin-bottom: 8px;
    }
    .card-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .pill {
      font-size: 10px;
      color: rgba(255,255,255,0.35);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
      padding: 2px 8px;
      border-radius: 10px;
    }
    .card-arrow {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(6px);
      color: white;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .animal-card:hover .card-arrow {
      opacity: 1;
    }
    .nav-search-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      color: rgba(255,255,255,0.6);
      font-size: 13px;
      font-weight: 500;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 6px 14px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .nav-search-btn:hover {
      background: rgba(74,222,128,0.1);
      border-color: rgba(74,222,128,0.25);
      color: #4ade80;
    }

  nav(class="nav-bar" style="display:flex; align-items:center; justify-content:space-between; padding:16px 32px; border-bottom:1px solid rgba(255,255,255,0.07); position:sticky; top:0; z-index:50; background:rgba(2,6,12,0.95); backdrop-filter:blur(12px);")
    div(style="display:flex; align-items:center; gap:14px;")
      span(style="font-size:1.4rem;") 🌿
      a(href="/home" style="color:white; font-size:1.1rem; font-weight:900; text-decoration:none;") AnimaliaDex
    div(style="display:flex; align-items:center; gap:20px;")
      a(href="/explorar" style="color:#4ade80; font-size:13px; font-weight:700; text-decoration:none;") Explorar
      a(href="/acercade" style="color:rgba(255,255,255,0.5); font-size:13px; text-decoration:none;") Acerca de
      a(href="/buscar" class="nav-search-btn")
        span 🔍
        span Buscar
    div(style="display:flex; align-items:center; gap:10px;")
      if user && user.rol !== 'invitado'
        a(href="/panel" style="background:#22c55e; color:white; font-size:12px; font-weight:700; padding:7px 16px; border-radius:20px; text-decoration:none;") + Proponer
      if user && user.rol === 'admin'
        a(href="/admin" style="background:rgba(168,85,247,0.15); border:1px solid rgba(168,85,247,0.3); color:#c4b5fd; font-size:12px; padding:7px 14px; border-radius:20px; text-decoration:none;") Admin
      span(style="color:rgba(255,255,255,0.3); font-size:13px;") #{user.username}
      a(href="/logout" style="color:rgba(255,255,255,0.35); font-size:12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); padding:6px 14px; border-radius:20px; text-decoration:none;") Salir

  main(style="max-width:1400px; margin:0 auto; padding:36px 24px;")

    div(style="margin-bottom:28px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;")
      div
        h1(style="color:white; font-size:1.6rem; font-weight:900; margin-bottom:4px;") 🎲 Explorador aleatorio
        p(style="color:rgba(255,255,255,0.3); font-size:13px;") #{animales.length} especies — orden diferente cada vez que entras
      a(href="/explorar" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:rgba(255,255,255,0.5); font-size:12px; font-weight:700; padding:9px 18px; border-radius:12px; text-decoration:none; display:flex; align-items:center; gap:6px;")
        span 🔀
        span Mezclar de nuevo

    div(style="columns: 2; column-gap: 14px;" class="grid-animales")
      style.
        @media(min-width:640px)  { .grid-animales { columns: 3; } }
        @media(min-width:900px)  { .grid-animales { columns: 4; } }
        @media(min-width:1200px) { .grid-animales { columns: 5; } }
        @media(min-width:1400px) { .grid-animales { columns: 6; } }
        .grid-animales .animal-card { break-inside: avoid; margin-bottom: 14px; display: block; }

      each item, i in animales
        a(href=item.url class="animal-card" style=`animation-delay:${Math.min(i * 0.025, 1.2)}s`)
          if item.animal.imagen
            img(src=item.animal.imagen alt=item.animal.nombre loading="lazy")
          else
            div(style="width:100%; height:160px; display:flex; align-items:center; justify-content:center; font-size:2.5rem; background:rgba(255,255,255,0.03);")= item.categoria.icon
          span(class="card-arrow") Ver →
          div(class="card-body")
            div(class="card-tag")
              span= item.categoria.icon
              span= item.categoria.name
            p(class="card-name")= item.animal.nombre
            p(class="card-sci")= item.animal.nombreCientifico
            div(class="card-pills")
              if item.animal.conservacion
                span(class="pill")= item.animal.conservacion
              if item.animal.alimentacion
                span(class="pill")= item.animal.alimentacion.split('—')[0].trim()

  footer(style="text-align:center; padding:24px; color:rgba(255,255,255,0.12); font-size:11px; border-top:1px solid rgba(255,255,255,0.05);") AnimaliaDex · BioNexus Labs
