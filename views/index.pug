extends layout

block content
  -
    const imgs = {
      mamiferos:    'https://images.unsplash.com/photo-1474511320723-9a56873867b5?w=400&q=80',
      aves:         'https://images.unsplash.com/photo-1444464666168-49d633b86797?w=400&q=80',
      reptiles:     'https://images.unsplash.com/photo-1504450874802-0ba2bcd9b5ae?w=400&q=80',
      anfibios:     'https://images.unsplash.com/photo-1459262838948-3e2de6c1ec80?w=400&q=80',
      peces:        'https://images.unsplash.com/photo-1534043464124-3be32fe000c9?w=400&q=80',
      artropodos:   'https://images.unsplash.com/photo-1535083783855-ded51a9b5041?w=400&q=80',
      moluscos:     'https://images.unsplash.com/photo-1518020382113-a7e8fc38eac9?w=400&q=80',
      equinodermos: 'https://images.unsplash.com/photo-1582967788606-a171c1080cb0?w=400&q=80',
      anelidos:     'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=400&q=80'
    }

  nav(class="flex items-center justify-between px-8 py-4 border-b border-white/10")
    div(class="flex items-center gap-3")
      span(class="text-2xl") 🌿
      a(href="/home" class="text-xl font-black tracking-tight text-white") AnimaliaDex
    div(class="flex items-center gap-3 flex-wrap justify-end")
      span(class="text-white/40 text-sm") #{user ? user.username : ''}
      if user && user.rol === 'invitado'
        a(href="/registro" class="text-xs bg-green-500/20 border border-green-400/30 text-green-300 px-4 py-2 rounded-full hover:bg-green-500/40 transition-colors") Crear cuenta
      if user && user.rol !== 'invitado'
        a(href="/panel" class="text-xs bg-green-500/20 hover:bg-green-500/40 border border-green-400/30 text-green-300 px-4 py-2 rounded-full transition-colors") + Proponer animal
      if user && user.rol === 'admin'
        a(href="/admin" class="text-xs bg-purple-500/20 hover:bg-purple-500/40 border border-purple-400/30 text-purple-300 px-4 py-2 rounded-full transition-colors") Panel admin
      a(href="/logout" class="text-xs bg-white/10 hover:bg-white/20 px-4 py-2 rounded-full transition-colors text-white/60") Salir

  main(class="flex-grow max-w-7xl mx-auto w-full px-6 py-10")

    if query && query.publicado
      div(class="bg-green-500/20 border border-green-400/30 text-green-300 rounded-2xl px-6 py-3 mb-6 text-sm") ✅ Publicación enviada correctamente.

    div(class="grid grid-cols-1 lg:grid-cols-3 gap-10")

      div(class="lg:col-span-2")
        h2(class="text-5xl font-black mb-2") El Reino Animal
        p(class="text-white/40 text-sm mb-10 uppercase tracking-widest") Selecciona un grupo para explorar

        if user && user.rol === 'invitado'
          div(class="bg-white/5 border border-white/10 rounded-2xl px-6 py-4 mb-8 text-sm text-white/50")
            | Estás en modo invitado.
            a(href="/registro" class="text-green-400 hover:text-green-300 ml-2 underline") Crea una cuenta para proponer animales.

        section(class="mb-12")
          div(class="flex items-center gap-3 mb-5")
            div(class="h-px flex-grow bg-white/10")
            h3(class="text-xs font-bold uppercase tracking-widest text-cyan-400 px-4") Vertebrados
            div(class="h-px flex-grow bg-white/10")
          div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3")
            each v in vertebrados
              if v
                a(href=`/animal/${v.id}` class="group relative rounded-2xl overflow-hidden h-40 block")
                  img(src=imgs[v.id] alt=v.name class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500")
                  div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent")
                  div(class="absolute bottom-0 left-0 right-0 p-3")
                    p(class="font-black text-white text-xs uppercase tracking-wide")= v.name

        section
          div(class="flex items-center gap-3 mb-5")
            div(class="h-px flex-grow bg-white/10")
            h3(class="text-xs font-bold uppercase tracking-widest text-green-400 px-4") Invertebrados
            div(class="h-px flex-grow bg-white/10")
          div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3")
            each inv in invertebrados
              if inv
                a(href=`/animal/${inv.id}` class="group relative rounded-2xl overflow-hidden h-40 block")
                  img(src=imgs[inv.id] alt=inv.name class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500")
                  div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent")
                  div(class="absolute bottom-0 left-0 right-0 p-3")
                    p(class="font-black text-white text-xs uppercase tracking-wide")= inv.name

      div(class="lg:col-span-1")
        h2(class="text-2xl font-black mb-6") Comunidad
          span(class="ml-2 text-white/30 text-base font-normal") feed

        if user && user.rol !== 'invitado'
          form(method="POST" action="/publicar" class="bg-white/5 border border-white/10 rounded-2xl p-5 mb-6")
            input(
              type="text" name="titulo"
              placeholder="Título (opcional)"
              class="w-full bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl px-4 py-2 text-sm mb-3 focus:outline-none focus:border-green-400"
            )
            textarea(
              name="contenido" rows="3" required
              placeholder="¿Qué quieres compartir con la comunidad?"
              class="w-full bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl px-4 py-2 text-sm mb-3 focus:outline-none focus:border-green-400 resize-none"
            )
            button(type="submit" class="w-full bg-green-500 hover:bg-green-400 text-white text-xs font-bold py-2 rounded-xl transition-colors uppercase tracking-wide") Publicar

        if feed && feed.length
          div(class="space-y-4")
            each item in feed
              div(class=`rounded-2xl p-5 border ${item.tipo === 'animal_nuevo' ? 'bg-green-500/5 border-green-400/20' : 'bg-white/5 border-white/10'}`)
                div(class="flex items-center gap-3 mb-3")
                  div(class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-sm font-black text-white/60")
                    | #{item.autor ? item.autor.username.charAt(0).toUpperCase() : '?'}
                  div
                    p(class="text-white/80 text-xs font-bold") #{item.autor ? item.autor.username : 'Sistema'}
                    p(class="text-white/30 text-xs") #{new Date(item.createdAt).toLocaleDateString('es-MX', { day:'numeric', month:'short', year:'numeric' })}
                  if item.tipo === 'animal_nuevo'
                    span(class="ml-auto text-xs bg-green-500/20 border border-green-400/30 text-green-300 px-2 py-1 rounded-full") Nuevo animal
                if item.titulo
                  p(class="text-white font-bold text-sm mb-1")= item.titulo
                p(class="text-white/60 text-sm leading-relaxed")= item.contenido
                if item.imagen
                  img(src=item.imagen alt="imagen" class="w-full rounded-xl mt-3 object-cover h-32")
        else
          div(class="text-center py-12 text-white/20")
            p(class="text-4xl mb-3") 🌿
            p(class="text-sm") Sé el primero en publicar algo.

  footer(class="text-center py-6 text-white/20 text-xs border-t border-white/5") AnimaliaDex · Explorador de especies
