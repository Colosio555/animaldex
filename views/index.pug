extends layout

block content
  style.
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInLeft {
      from { opacity: 0; transform: translateX(-20px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.92); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .card-animal {
      opacity: 0;
      animation: scaleIn 0.5s ease forwards;
    }
    .hero-title {
      opacity: 0;
      animation: fadeInUp 0.7s ease 0.1s forwards;
    }
    .hero-sub {
      opacity: 0;
      animation: fadeInUp 0.7s ease 0.3s forwards;
    }
    .hero-cta {
      opacity: 0;
      animation: fadeInUp 0.7s ease 0.5s forwards;
    }
    .seccion-label {
      opacity: 0;
      animation: fadeInLeft 0.6s ease forwards;
    }
    .feed-item {
      opacity: 0;
      animation: fadeInUp 0.5s ease forwards;
    }
    .nav-animate {
      opacity: 0;
      animation: slideDown 0.5s ease forwards;
    }
    .card-animal:hover img {
      transform: scale(1.1);
    }
    .card-animal img {
      transition: transform 0.7s ease;
    }
    .hero-search-wrap {
      opacity: 0;
      animation: fadeInUp 0.7s ease 0.45s forwards;
    }
    .hero-search {
      display: flex;
      align-items: center;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      overflow: hidden;
      max-width: 480px;
      margin: 0 auto;
      transition: border-color 0.2s, background 0.2s;
    }
    .hero-search:focus-within {
      border-color: rgba(74,222,128,0.45);
      background: rgba(74,222,128,0.04);
    }
    .hero-search input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: white;
      font-size: 0.9rem;
      padding: 13px 18px;
    }
    .hero-search input::placeholder { color: rgba(255,255,255,0.28); }
    .hero-search button {
      background: #22c55e;
      border: none;
      color: white;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      padding: 13px 22px;
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
    }
    .hero-search button:hover { background: #4ade80; }
    .nav-search-btn {
      display: flex; align-items: center; gap: 6px;
      color: rgba(255,255,255,0.6);
      font-size: 13px; font-weight: 500;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 6px 14px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .nav-search-btn:hover {
      background: rgba(74,222,128,0.1);
      border-color: rgba(74,222,128,0.25);
      color: #4ade80;
    }

  -
    const imgs = {
      mamiferos:    'https://i.pinimg.com/736x/32/40/95/3240952750609002e41171b717f3d238.jpg',
      aves:         'https://i1-e.pinimg.com/1200x/a0/8a/a9/a08aa9e6630c2048c1f6342dda158a4a.jpg',
      reptiles:     'https://i.pinimg.com/736x/45/bf/f2/45bff221e32b3f762e297c82440ffb7c.jpg',
      anfibios:     'https://i.pinimg.com/736x/9b/f5/c4/9bf5c4d5fdc51568fa9436bb41bb7b6b.jpg',
      peces:        'https://i1-e.pinimg.com/1200x/c3/be/6a/c3be6a4caafee9d54fe15e60859f1f6d.jpg',
      artropodos:   'https://i.pinimg.com/736x/39/8b/44/398b44161c8577651cfb7b0afc334100.jpg',
      moluscos:     'https://i.pinimg.com/736x/a0/e5/7e/a0e57e0a2fa5fabd84b6cf0ef7e8681d.jpg',
      equinodermos: 'https://i1-e.pinimg.com/1200x/40/6c/3a/406c3a0f3c582e12cbe2b0b9b2c886b2.jpg',
      anelidos:     'https://i.pinimg.com/736x/a1/88/0b/a1880bee2a0e348f6a43ee553d013685.jpg'
    }
    const subtitulos = {
      mamiferos:    'Gigantes y Cuidadores',
      aves:         'Maestros del Vuelo',
      reptiles:     'Escamas y Sigilo',
      anfibios:     'Agua y Tierra',
      peces:        'Reyes del Mar',
      artropodos:   'Exoesqueletos',
      moluscos:     'Blandos y Letales',
      equinodermos: 'Estrellas del Fondo',
      anelidos:     'Del Suelo al Mar'
    }

  nav(class="nav-animate flex items-center justify-between px-8 py-4 border-b border-white/10 sticky top-0 z-50 bg-slate-950/95 backdrop-blur")
    div(class="flex items-center gap-3")
      span(class="text-2xl") 🌿
      a(href="/home" class="text-xl font-black tracking-tight text-white") AnimaliaDex
    div(class="hidden md:flex items-center gap-6")
      a(href="/home" class="text-sm text-white/70 hover:text-white transition-colors font-medium") Explorar
      a(href="/panel" class="text-sm text-white/70 hover:text-white transition-colors font-medium") Comunidad
      //- ── BUSCADOR EN NAVBAR ──
      a(href="/buscar" class="nav-search-btn")
        span 🔍
        span Buscar
    div(class="flex items-center gap-3")
      if user && user.rol !== 'invitado'
        a(href="/panel" class="text-sm bg-green-500 hover:bg-green-400 text-white font-bold px-4 py-2 rounded-full transition-colors") + Proponer animal
      if user && user.rol === 'admin'
        a(href="/admin" class="text-xs bg-purple-500/20 hover:bg-purple-500/40 border border-purple-400/30 text-purple-300 px-4 py-2 rounded-full transition-colors") Admin
      span(class="text-white/40 text-sm hidden sm:block") #{user ? user.username : ''}
      a(href="/logout" class="text-xs bg-white/10 hover:bg-white/20 px-4 py-2 rounded-full transition-colors text-white/60") Salir

  main(class="flex-grow")

    div(class="relative overflow-hidden" style="background: linear-gradient(180deg, #0a1628 0%, #0f172a 100%);")
      div(class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, #4ade80 1px, transparent 1px); background-size: 40px 40px;")
      div(class="max-w-7xl mx-auto px-6 py-12 text-center relative z-10")
        h1(class="hero-title text-5xl md:text-6xl font-black text-white mb-3")
          | Explora el
          span(class="text-green-400") &nbsp;Reino Animal
        p(class="hero-sub text-white/40 text-base max-w-xl mx-auto mb-6") Descubre, aprende y comparte sobre las especies más fascinantes del planeta.

        //- ── BARRA DE BÚSQUEDA EN HERO ──
        div(class="hero-search-wrap mb-6")
          form(method="GET" action="/buscar" class="hero-search")
            input(
              type="text" name="q"
              placeholder="Busca un animal, dieta, hábitat..."
            )
            button(type="submit") 🔍 Buscar

        if user && user.rol === 'invitado'
          div(class="hero-cta flex gap-3 justify-center")
            a(href="/registro" class="bg-green-500 hover:bg-green-400 text-white font-bold px-6 py-3 rounded-2xl text-sm transition-colors") Crear cuenta gratis
            a(href="/login" class="bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-2xl text-sm transition-colors border border-white/20") Iniciar sesión

    div(class="max-w-7xl mx-auto px-4 py-10")
      if query && query.publicado
        div(class="bg-green-500/20 border border-green-400/30 text-green-300 rounded-2xl px-6 py-3 mb-6 text-sm") ✅ Publicación enviada.

      div(class="grid grid-cols-1 xl:grid-cols-4 gap-8")

        div(class="xl:col-span-3")

          section(class="mb-10")
            div(class="seccion-label flex items-center gap-4 mb-5" style="animation-delay: 0.1s")
              div(class="h-px flex-grow bg-white/10")
              span(class="text-xs font-black uppercase tracking-widest text-cyan-400 px-4 py-1.5 bg-cyan-400/10 rounded-full border border-cyan-400/20") Vertebrados
              div(class="h-px flex-grow bg-white/10")

            div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4")
              each v, i in vertebrados
                if v
                  a(href=`/animal/${v.id}` class="card-animal group relative rounded-3xl overflow-hidden block" style=`height:200px; animation-delay:${0.1 + i * 0.08}s`)
                    img(src=imgs[v.id] alt=v.name class="w-full h-full object-cover")
                    div(class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent")
                    div(class="absolute inset-0 bg-green-500/0 group-hover:bg-green-500/10 transition-colors duration-300")
                    div(class="absolute bottom-0 left-0 right-0 p-4")
                      p(class="font-black text-white text-sm uppercase tracking-wide leading-tight")= v.name
                      p(class="text-white/50 text-xs mt-0.5 group-hover:text-green-300 transition-colors")= subtitulos[v.id]
                    div(class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-1 group-hover:translate-y-0")
                      span(class="bg-green-500 text-white text-xs font-bold px-2 py-1 rounded-full") Ver →

          section
            div(class="seccion-label flex items-center gap-4 mb-5" style="animation-delay: 0.5s")
              div(class="h-px flex-grow bg-white/10")
              span(class="text-xs font-black uppercase tracking-widest text-green-400 px-4 py-1.5 bg-green-400/10 rounded-full border border-green-400/20") Invertebrados
              div(class="h-px flex-grow bg-white/10")

            div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4")
              each inv, i in invertebrados
                if inv
                  a(href=`/animal/${inv.id}` class="card-animal group relative rounded-3xl overflow-hidden block" style=`height:200px; animation-delay:${0.55 + i * 0.08}s`)
                    img(src=imgs[inv.id] alt=inv.name class="w-full h-full object-cover")
                    div(class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent")
                    div(class="absolute inset-0 bg-green-500/0 group-hover:bg-green-500/10 transition-colors duration-300")
                    div(class="absolute bottom-0 left-0 right-0 p-4")
                      p(class="font-black text-white text-sm uppercase tracking-wide leading-tight")= inv.name
                      p(class="text-white/50 text-xs mt-0.5 group-hover:text-green-300 transition-colors")= subtitulos[inv.id]
                    div(class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-1 group-hover:translate-y-0")
                      span(class="bg-green-500 text-white text-xs font-bold px-2 py-1 rounded-full") Ver →

        //- ── Feed ──
        div(class="xl:col-span-1")
          div(class="sticky top-20")

            if user && user.rol !== 'invitado'
              div(class="feed-item bg-white/5 border border-white/10 rounded-2xl mb-5 overflow-hidden" style="animation-delay: 0.2s")
                div(class="px-4 pt-4 pb-3")
                  div(class="flex items-center gap-3")
                    div(class="w-8 h-8 rounded-full bg-green-500/20 border border-green-400/30 flex items-center justify-center text-xs font-black text-green-300 flex-shrink-0")
                      | #{user.username.charAt(0).toUpperCase()}
                    input(
                      type="text"
                      placeholder="Comparte tu hallazgo..."
                      readonly
                      onclick="document.getElementById('formPublicar').classList.toggle('hidden')"
                      class="flex-grow bg-white/5 border border-white/10 text-white/40 placeholder-white/30 rounded-full px-3 py-2 text-xs cursor-pointer hover:bg-white/10 transition-colors focus:outline-none"
                    )
                div(id="formPublicar" class="hidden border-t border-white/10 px-4 py-4")
                  form(method="POST" action="/publicar" enctype="multipart/form-data")
                    input(type="text" name="titulo" placeholder="Título (opcional)" class="w-full bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl px-3 py-2 text-xs mb-2 focus:outline-none focus:border-green-400")
                    textarea(name="contenido" rows="3" required placeholder="¿Qué quieres compartir?" class="w-full bg-white/5 border border-white/10 text-white placeholder-white/20 rounded-xl px-3 py-2 text-xs mb-2 focus:outline-none focus:border-green-400 resize-none")
                    div(class="flex items-center justify-between")
                      label(class="flex items-center gap-1 cursor-pointer text-white/30 hover:text-green-400 text-xs transition-colors")
                        input(type="file" name="imagen" accept="image/*" class="hidden" onchange="mostrarNombre(this)")
                        span 📷 Foto
                        span#nombreArchivo(class="text-white/20 text-xs ml-1")
                      button(type="submit" class="bg-green-500 hover:bg-green-400 text-white text-xs font-bold py-1.5 px-4 rounded-xl transition-colors") Publicar

            div(class="flex items-center justify-between mb-3")
              h2(class="text-sm font-black text-white uppercase tracking-widest") Comunidad
              span(class="text-white/20 text-xs") #{new Date().toLocaleDateString('es-MX', {day:'numeric', month:'short'})}

            if feed && feed.length
              div(class="space-y-3")
                each item, i in feed
                  div(id=`pub-${item._id}` class="feed-item bg-slate-900 border border-white/10 rounded-2xl overflow-hidden" style=`animation-delay:${0.3 + i * 0.1}s`)
                    div(class="px-4 pt-4 pb-2")
                      div(class="flex items-center gap-2 mb-2")
                        div(class=`w-7 h-7 rounded-full flex items-center justify-center text-xs font-black flex-shrink-0 ${item.tipo === 'animal_nuevo' ? 'bg-green-500/30 text-green-300' : 'bg-blue-500/20 text-blue-300'}`)
                          | #{item.autor ? item.autor.username.charAt(0).toUpperCase() : '?'}
                        div
                          p(class="text-white text-xs font-bold leading-tight") #{item.autor ? item.autor.username : 'Sistema'}
                          p(class="text-white/20 text-xs") #{new Date(item.createdAt).toLocaleTimeString('es-MX', {hour:'2-digit', minute:'2-digit'})}
                        if item.tipo === 'animal_nuevo'
                          span(class="ml-auto text-xs bg-green-500/20 border border-green-400/20 text-green-300 px-1.5 py-0.5 rounded-full") 🐾
                      if item.titulo
                        p(class="text-white font-bold text-xs mb-1")= item.titulo
                      p(class="text-white/60 text-xs leading-relaxed line-clamp-3")= item.contenido

                    if item.imagen
                      img(src=item.imagen alt="imagen" class="w-full object-cover max-h-48")

                    div(class="px-4 py-2")
                      div(class="flex items-center justify-between text-white/20 text-xs mb-2")
                        span 👍 #{item.likes ? item.likes.length : 0}
                        button(onclick=`toggleComentarios('${item._id}')` class="hover:text-white/50 transition-colors") 💬 #{item.comentarios ? item.comentarios.length : 0}
                      div(class="flex gap-1 border-t border-white/5 pt-2")
                        form(method="POST" action=`/like/${item._id}` class="flex-1")
                          button(type="submit" class="w-full flex items-center justify-center gap-1 py-1.5 rounded-lg text-xs text-white/30 hover:bg-white/5 hover:text-blue-400 transition-all") 👍 Me gusta
                        button(onclick=`toggleComentarios('${item._id}')` class="flex-1 flex items-center justify-center gap-1 py-1.5 rounded-lg text-xs text-white/30 hover:bg-white/5 hover:text-green-400 transition-all") 💬 Comentar

                    div(id=`comentarios-${item._id}` class="hidden border-t border-white/5 bg-black/20 px-4 py-3")
                      if item.comentarios && item.comentarios.length
                        div(class="space-y-2 mb-3")
                          each com in item.comentarios
                            div(class="flex gap-2")
                              div(class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center text-xs font-black text-white/40 flex-shrink-0")
                                | #{com.autor ? com.autor.username.charAt(0).toUpperCase() : '?'}
                              div(class="bg-white/5 rounded-xl px-2 py-1 flex-grow")
                                p(class="text-white/60 text-xs font-bold") #{com.autor ? com.autor.username : 'Usuario'}
                                p(class="text-white/50 text-xs")= com.contenido
                      if user && user.rol !== 'invitado'
                        form(method="POST" action=`/comentar/${item._id}` class="flex gap-1 mt-2")
                          input(type="text" name="contenido" required placeholder="Comentar..." class="flex-grow bg-white/10 border border-white/10 text-white placeholder-white/20 rounded-full px-3 py-1 text-xs focus:outline-none focus:border-green-400")
                          button(type="submit" class="bg-green-500 hover:bg-green-400 text-white text-xs font-bold px-2 py-1 rounded-full transition-colors") →
                      else
                        p(class="text-white/20 text-xs italic text-center mt-1")
                          a(href="/login" class="text-green-400") Inicia sesión
                          |  para comentar.
            else
              div(class="feed-item text-center py-10 text-white/20 bg-white/5 border border-white/10 rounded-2xl" style="animation-delay:0.3s")
                p(class="text-3xl mb-2") 🌿
                p(class="text-xs font-bold") Sin publicaciones hoy
                p(class="text-xs mt-1") ¡Sé el primero!

  script.
    function toggleComentarios(id) {
      const el = document.getElementById('comentarios-' + id);
      el.classList.toggle('hidden');
    }
    function mostrarNombre(input) {
      document.getElementById('nombreArchivo').textContent = input.files[0] ? input.files[0].name : '';
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.card-animal, .feed-item, .seccion-label').forEach(el => {
      el.style.animationPlayState = 'paused';
      observer.observe(el);
    });

  footer(class="text-center py-6 text-white/20 text-xs border-t border-white/5 mt-10") AnimaliaDex · Explorador de especies
