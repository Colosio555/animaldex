extends ../layout

block content
  style.
    @keyframes fadeInUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
    @keyframes scaleIn  { from{opacity:0;transform:scale(0.94)}       to{opacity:1;transform:scale(1)} }
    .card-sub { opacity:0; animation: scaleIn 0.5s ease forwards; }

  nav(class="flex items-center justify-between px-8 py-4 border-b border-white/10 sticky top-0 z-50 bg-slate-950/95 backdrop-blur")
    div(class="flex items-center gap-3 text-sm text-white/40")
      a(href="/home" class="hover:text-white transition-colors") Inicio
      span /
      span(class="text-white") #{categoria.name}
    div(class="flex items-center gap-3")
      if user && user.rol !== 'invitado'
        a(href="/panel" class="text-xs bg-green-500/20 border border-green-400/30 text-green-300 px-4 py-2 rounded-full hover:bg-green-500/40 transition-colors") + Proponer
      if user && user.rol === 'admin'
        a(href="/admin" class="text-xs bg-purple-500/20 border border-purple-400/30 text-purple-300 px-4 py-2 rounded-full") Admin
      a(href="/logout" class="text-xs bg-white/10 hover:bg-white/20 px-4 py-2 rounded-full text-white/60") Salir

  div(class="relative h-72 overflow-hidden")
    img(src=categoria.imagen alt=categoria.name class="w-full h-full object-cover")
    div(class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(15,23,42,1))")
    div(class="absolute bottom-0 left-0 right-0 px-8 pb-8" style="animation:fadeInUp 0.6s ease forwards")
      p(class="text-white/50 text-xs uppercase tracking-widest mb-2") Grupo taxonómico
      h1(class="text-5xl font-black text-white mb-3") #{categoria.name}
      p(class="text-white/60 text-base max-w-2xl leading-relaxed") #{categoria.descripcion}

  main(class="max-w-6xl mx-auto px-6 py-12")
    h2(class="text-xl font-black text-white mb-2 uppercase tracking-widest") Subgrupos
    p(class="text-white/30 text-sm mb-8") Selecciona un subgrupo para ver los animales que lo componen

    div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6")
      each sub, i in categoria.subtypes
        a(href=`/animal/${categoria.id}/${sub.name.toLowerCase().replace(/ /g,'-')}` class="card-sub group block rounded-3xl overflow-hidden border border-white/10 hover:border-white/30 transition-all duration-300 hover:-translate-y-2" style=`animation-delay:${i*0.08}s`)
          div(style="position:relative; height:200px; overflow:hidden;")
            if sub.imagen
              img(src=sub.imagen alt=sub.name class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700")
            else
              div(class="w-full h-full bg-slate-800")
            div(style="position:absolute;inset:0;background:linear-gradient(to bottom,transparent 30%,rgba(0,0,0,0.9))")
            div(style="position:absolute;bottom:0;left:0;right:0;padding:20px;")
              p(class="text-white font-black text-lg uppercase tracking-wide")= sub.name
              p(class="text-white/40 text-xs mt-1") #{sub.animales ? sub.animales.length : 0} especie(s) documentada(s)
          div(class="bg-slate-900 px-5 py-4")
            p(class="text-white/50 text-xs leading-relaxed line-clamp-2")= sub.descripcion || 'Explora las especies de este subgrupo.'
            div(class="flex items-center gap-2 mt-3 text-green-400 text-xs font-bold group-hover:gap-3 transition-all")
              span Ver animales
              span →

  footer(class="text-center py-6 text-white/20 text-xs border-t border-white/5") AnimaliaDex · Explorador de especies
