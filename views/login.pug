extends layout

block content
  div(class="min-h-screen flex items-center justify-center relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a2f 50%, #0f172a 100%);")
    
    div(class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, #4ade80 1px, transparent 1px); background-size: 48px 48px;")

    div(class="relative z-10 w-full max-w-sm mx-4")
      div(class="text-center mb-8")
        div(class="text-7xl mb-4") 🌿
        h1(class="text-4xl font-black text-white tracking-tight") AnimaliaDex
        p(class="text-green-400 text-sm mt-1 tracking-widest uppercase") Explorador de especies

      div(class="bg-white/10 backdrop-blur rounded-3xl p-8 border border-white/20 shadow-2xl")
        if error
          div(class="bg-red-500/20 border border-red-400/40 text-red-300 text-sm rounded-xl px-4 py-3 mb-6 text-center")= error

        form(method="POST" action="/login")
          div(class="mb-5")
            label(class="block text-green-300 text-xs font-bold uppercase tracking-widest mb-2") Usuario
            input(
              type="text"
              name="username"
              placeholder="admin"
              class="w-full bg-white/10 border border-white/20 text-white placeholder-white/30 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-green-400 transition-colors"
            )
          div(class="mb-7")
            label(class="block text-green-300 text-xs font-bold uppercase tracking-widest mb-2") Contraseña
            input(
              type="password"
              name="password"
              placeholder="••••••••"
              class="w-full bg-white/10 border border-white/20 text-white placeholder-white/30 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-green-400 transition-colors"
            )
          button(
            type="submit"
            class="w-full bg-green-500 hover:bg-green-400 text-white font-bold py-3 rounded-xl transition-colors text-sm tracking-wide uppercase"
          ) Entrar al explorador

        p(class="text-center text-white/30 text-xs mt-6") Acceso protegido · AnimaliaDex